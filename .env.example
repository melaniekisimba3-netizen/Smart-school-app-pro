# ==============================================================================
# SMARTSCHOOL RDC - CONFIGURATION D'ENVIRONNEMENT DE DÉVELOPPEMENT / PRODUCTION
# ==============================================================================
# Copiez ce fichier vers .env et renseignez vos véritables clés sécurisées.

# ------------------------------------------------------------------------------
# 1. APPLICATION & DOMAINE
# ------------------------------------------------------------------------------
NODE_ENV="development"
PORT=3000
APP_NAME="SmartSchool RDC"
APP_URL="http://localhost:3000"
ALLOWED_ORIGINS="http://localhost:3000"
ENABLE_SSL=false

# ------------------------------------------------------------------------------
# 2. SÉCURITÉ & AUTHENTIFICATION SÉCURISÉE
# ------------------------------------------------------------------------------
JWT_SECRET="votre_cle_secrete_jwt_super_securisee_remplacer_ici"
JWT_EXPIRATION="8h"
PASSWORD_SALT_ROUNDS=12
ENCRYPTION_KEY="votre_cle_de_chiffrement_32_octets_hexadecimales"
MANDATORY_2FA=false

# ------------------------------------------------------------------------------
# 3. BASE DE DONNÉES POSTGRESQL (OPTIONNELLE SI FIRESTORE EST ACTIVÉ)
# ------------------------------------------------------------------------------
DATABASE_URL="postgresql://user:password@localhost:5432/smartschool_db?sslmode=disable"
DATABASE_MAX_CONNECTIONS=10
DATABASE_IDLE_TIMEOUT=30000

# ------------------------------------------------------------------------------
# 4. FIREBASE AUTHENTICATION & FIRESTORE (PRODUCTION BACKEND PRINCIPAL)
# ------------------------------------------------------------------------------
VITE_FIREBASE_API_KEY="votre_cle_api_firebase_ici"
VITE_FIREBASE_AUTH_DOMAIN="votre_projet_firebase.firebaseapp.com"
VITE_FIREBASE_PROJECT_ID="votre_projet_firebase_id"
VITE_FIREBASE_STORAGE_BUCKET="votre_projet_firebase.appspot.com"
VITE_FIREBASE_MESSAGING_SENDER_ID="1234567890"
VITE_FIREBASE_APP_ID="1:1234567890:web:abcdef123456"

# ------------------------------------------------------------------------------
# 5. GOOGLE GEMINI AI (SERVER-SIDE SECRET EXCLUSIF - NE JAMAIS EXPOSER AU CLIENT)
# ------------------------------------------------------------------------------
GEMINI_API_KEY="votre_cle_api_gemini_secrete_cote_serveur"

# ------------------------------------------------------------------------------
# 6. PASSERELLES MOBILE MONEY RDC (SÉCURISÉES EN VARIABLES D'ENVIRONNEMENT)
# ------------------------------------------------------------------------------
MPESA_API_KEY="votre_cle_mpesa_secrete"
MPESA_MERCHANT_ID="votre_identifiant_marchand_mpesa"
AIRTEL_MONEY_CLIENT_SECRET="votre_secret_client_airtel"
ORANGE_MONEY_AUTH_TOKEN="votre_token_auth_orange"
RAW_BANK_API_KEY="votre_cle_api_rawbank"

# ------------------------------------------------------------------------------
# 7. LOGS ET INFRASTRUCTURE
# ------------------------------------------------------------------------------
LOG_LEVEL="info"
SENTRY_DSN="votre_sentry_dsn_si_applicable"
